@echo off
chcp 65001 >nul
setlocal
set PYTHONIOENCODING=utf-8
set PYTHONUTF8=1
title OTZAR - ROBOT DE FIESTAS - SUKOT 5787 (5 por Rab)
color 0E
cls
echo.
echo  ==============================================================
echo    ROBOT DE FIESTAS - SUKOT 5787 (26 sep 2026) - 5 POR RAB
echo  ==============================================================
echo.
echo   1) Instala la version nueva del robot en C:\OTZAR
echo      (solo baja lo que DIGA Sukot en el titulo, aparta lo que
 echo      una corrida anterior bajo mal, y sube lo que quedo pendiente)
echo   2) Busca AHORA shiurim de Sukot en los canales de YouTube de
echo      cada Rab, baja los 5 MAS VISTOS de cada canal (min 10 min),
echo      los sube a Archive y publica los feeds (Spotify los lee).
echo.
echo   TARDA 2 - 3 HORAS. No corras ACTUALIZAR al mismo tiempo.
echo   NO CIERRES LA VENTANA hasta que diga LISTO.
echo.
pause
where python >nul 2>&1 || ( echo   *** No veo python *** & pause & exit /b 9 )
if not exist "C:\OTZAR\" ( echo   *** No existe C:\OTZAR *** & pause & exit /b 9 )

rem ---- 1) robot nuevo (con backup del viejo) ----
findstr /b "PYB64:" "%~f0" > "%TEMP%\_rf_raw.txt"
(for /f "usebackq tokens=1,* delims=:" %%A in ("%TEMP%\_rf_raw.txt") do @echo %%B) > "%TEMP%\_rf.b64"
if exist "C:\OTZAR\robot_fiestas.py" copy /y "C:\OTZAR\robot_fiestas.py" "C:\OTZAR\robot_fiestas.py.bak_%RANDOM%" >nul
certutil -f -decode "%TEMP%\_rf.b64" "C:\OTZAR\robot_fiestas.py" >nul 2>&1
python -c "import ast,io;ast.parse(io.open(r'C:\OTZAR\robot_fiestas.py',encoding='utf-8').read())" || ( echo   *** el robot no paso la sintaxis *** & pause & exit /b 9 )
echo   [1/2] robot_fiestas.py instalado en C:\OTZAR

rem ---- 2) Sukot AHORA, 5 por canal ----
echo   [2/2] Buscando shiurim de Sukot (5 por Rab)...
echo.
cd /d C:\OTZAR
python robot_fiestas.py sukot2026 5
if errorlevel 2 (
  echo.
  echo   *** No habia internet o el DNS no respondio. Revisa la red y vuelve a correr este bat. ***
  pause
  exit /b 2
)
echo.
echo  ==============================================================
echo    LISTO. Log completo en C:\OTZAR\fiestas.log
echo    Aprieta ANUNCIAR para que el robot de WhatsApp los anuncie.
echo  ==============================================================
echo.
pause
exit /b 0

